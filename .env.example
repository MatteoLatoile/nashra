# Nashra V0.3 — Authentification et données cloud, à renseigner depuis Supabase > Connect.
# NE PAS ajouter de service_role ou de secret dans NEXT_PUBLIC_!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optionnel : tests Telegram LOCAUX uniquement (jamais sur Vercel / SaaS public).
# NASHRA_LOCAL_DEV=1
# TELEGRAM_BOT_TOKEN=
# Si Supabase est configuré, les routes Telegram locales exigent l’UUID de VOTRE compte :
# NASHRA_DEV_USER_ID=
# Optionnel : seul ce compte Telegram peut fournir des messages au bot :
# NASHRA_DEV_TELEGRAM_USER_ID=

# V0.4 — CLIENT TELEGRAM PERSONNEL (MTProto) : côté serveur uniquement.
# À obtenir dans my.telegram.org > API development tools, sans les communiquer.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Secret de 32 octets encodé hexadécimal, générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NASHRA_SESSION_ENCRYPTION_KEY=
